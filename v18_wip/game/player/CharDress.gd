class_name CharDress
extends RefCounted
## v0.18: real cloth on the costume.
## The hand-built costume pieces (hakama, obi, lacing, kasa, hachimaki, cords)
## were exported without UVs, so they could only ever be flat plastic colours.
## dress() projects UVs from the bind pose once per mesh (so the weave does not
## swim when the cloth moves), regenerates tangents and gives each piece a
## photographed CC0 fabric from Poly Haven at a real-world scale. The diffuse
## maps are stored as grey weave detail around 0.5, so the tint is the colour.

const TEX := "res://assets/char/tex/"
## material name -> [texture, metres per tile, tint, projection, rim]
const LOOK := {
	"Hakama": ["rough_linen", 0.22, Color(0.12, 0.14, 0.24), "cyl", 0.25],
	"Obi": ["crepe_satin", 0.16, Color(0.56, 0.17, 0.19), "cyl", 0.25],
	"Hachimaki": ["rough_linen", 0.10, Color(0.90, 0.89, 0.85), "cyl", 0.3],
	"Lacing": ["poly_wool_herringbone", 0.05, Color(0.66, 0.16, 0.17), "cyl", 0.3],
	"Straw": ["hessian_380", 0.09, Color(0.80, 0.70, 0.50), "top", 0.15],
	"Cord": ["hessian_380", 0.04, Color(0.74, 0.70, 0.64), "cyl", 0.2],
	# lacquered lamellar plates: five 6 cm lames per 30 cm, paired silk cords,
	# lacing holes, lacquer worn through to brown at the edges (generated by
	# tools/gen_char_tex.py; the colours are baked, so the tint is neutral)
	"Lacquer": ["armour_lame", 0.30, Color(0.5, 0.5, 0.5), "cyl", 0.0,
		{"clearcoat": 0.7, "clearcoat_roughness": 0.2, "normal_scale": 1.2}],
	# hair: fine strands along the head, stretched highlight across them
	"RoninHair": ["hair_strand", 0.05, Color(0.13, 0.11, 0.10), "cyl", 0.08,
		{"anisotropy": 0.65, "normal_scale": 0.7}],
}
## PBR files per texture id (Poly Haven ids end in _1k; generated ones do not)
const SUFFIX := {"armour_lame": "", "hair_strand": ""}

static var _mesh_cache := {}
static var _mat_cache := {}

static func dress(root: Node) -> int:
	var n := 0
	for mi in _meshes(root, []):
		var src: Mesh = mi.mesh
		if src == null: continue
		if _mesh_cache.has(src):
			mi.mesh = _mesh_cache[src]; n += 1; continue
		var hit := false
		for s in src.get_surface_count():
			var mat := src.surface_get_material(s)
			if mat != null and LOOK.has(mat.resource_name): hit = true
		_skin(mi)
		if not hit or not (src is ArrayMesh): continue
		var out := ArrayMesh.new()
		for s in src.get_surface_count():
			var mat := src.surface_get_material(s)
			var arr := src.surface_get_arrays(s)
			var fl: int = src.surface_get_format(s) & Mesh.ARRAY_FLAG_USE_8_BONE_WEIGHTS
			if mat != null and LOOK.has(mat.resource_name):
				var look: Array = LOOK[mat.resource_name]
				arr = _project(arr, String(look[3]))
				mat = _material(String(mat.resource_name), look)
			out.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arr, [], {}, fl)
			out.surface_set_material(out.get_surface_count() - 1, mat)
		_mesh_cache[src] = out
		mi.mesh = out
		n += 1
	return n

static func _meshes(n: Node, acc: Array) -> Array:
	if n is MeshInstance3D: acc.append(n)
	for c in n.get_children(): _meshes(c, acc)
	return acc

## Non-indexed copy with UVs in metres: "cyl" wraps around the vertical axis
## (seam at the back), "top" projects from above (hats). Triangles that span
## the seam are unwrapped so none of them smears the whole texture.
static func _project(arr: Array, mode: String) -> Array:
	var vt: PackedVector3Array = arr[Mesh.ARRAY_VERTEX]
	var idx: PackedInt32Array = arr[Mesh.ARRAY_INDEX] if arr[Mesh.ARRAY_INDEX] != null else PackedInt32Array()
	if idx.is_empty():
		for i in vt.size(): idx.append(i)
	var bb := AABB(vt[0], Vector3.ZERO)
	for p in vt: bb = bb.expand(p)
	var c := bb.get_center()
	var rad := maxf(0.04, 0.25 * (bb.size.x + bb.size.z))
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	var nrm: PackedVector3Array = arr[Mesh.ARRAY_NORMAL]
	var bones = arr[Mesh.ARRAY_BONES]
	var wts = arr[Mesh.ARRAY_WEIGHTS]
	var nb := 0
	if bones != null and (bones as PackedInt32Array).size() > 0:
		nb = (bones as PackedInt32Array).size() / vt.size()
		st.set_skin_weight_count(SurfaceTool.SKIN_8_WEIGHTS if nb == 8 else SurfaceTool.SKIN_4_WEIGHTS)
	for t in range(0, idx.size(), 3):
		var ang := [0.0, 0.0, 0.0]
		for k in 3:
			var p := vt[idx[t + k]] - c
			ang[k] = atan2(p.x, p.z)
		if mode == "cyl" and maxf(ang[0], maxf(ang[1], ang[2])) - minf(ang[0], minf(ang[1], ang[2])) > PI:
			for k in 3:
				if ang[k] < 0.0: ang[k] += TAU
		for k in 3:
			var i := idx[t + k]
			var p := vt[i] - c
			var uv := Vector2(ang[k] * rad, -p.y) if mode == "cyl" else Vector2(p.x, p.z)
			st.set_uv(uv)
			st.set_normal(nrm[i])
			if nb > 0:
				var bi := PackedInt32Array(); var bw := PackedFloat32Array()
				for j in nb:
					bi.append((bones as PackedInt32Array)[i * nb + j]); bw.append((wts as PackedFloat32Array)[i * nb + j])
				st.set_bones(bi); st.set_weights(bw)
			st.add_vertex(vt[i])
	st.index()
	st.generate_tangents()
	return st.commit_to_arrays()

static func _material(key: String, look: Array) -> StandardMaterial3D:
	if _mat_cache.has(key): return _mat_cache[key]
	var id := String(look[0])
	var m := StandardMaterial3D.new()
	m.resource_name = key
	var sfx: String = SUFFIX.get(id, "_1k")
	m.albedo_texture = load(TEX + id + "_diff" + sfx + ".jpg")
	var tint: Color = look[2]
	m.albedo_color = Color(tint.r * 2.0, tint.g * 2.0, tint.b * 2.0)
	m.normal_enabled = true
	m.normal_texture = load(TEX + id + "_nor" + sfx + ".jpg")
	m.normal_scale = 1.0
	m.roughness_texture = load(TEX + id + "_rough" + sfx + ".jpg")
	m.roughness_texture_channel = BaseMaterial3D.TEXTURE_CHANNEL_RED
	m.roughness = 1.0
	m.rim_enabled = true
	m.rim = float(look[4])
	m.rim_tint = 0.6
	var s := 1.0 / float(look[1])
	m.uv1_scale = Vector3(s, s, 1.0)
	m.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC
	var ex: Dictionary = look[5] if look.size() > 5 else {}
	if ex.has("normal_scale"): m.normal_scale = float(ex["normal_scale"])
	if ex.has("clearcoat"):
		m.clearcoat_enabled = true
		m.clearcoat = float(ex["clearcoat"])
		m.clearcoat_roughness = float(ex.get("clearcoat_roughness", 0.3))
	if ex.has("anisotropy"):
		m.anisotropy_enabled = true
		m.anisotropy = float(ex["anisotropy"])
	_mat_cache[key] = m
	return m

## Skin: light scatters under real skin, which is what keeps a face from
## reading as painted plastic. Screen-space SSS in skin mode, a skin-level
## specular (F0 ~0.028) and a touch less gloss on the head and arms.
static func _skin(mi: MeshInstance3D) -> void:
	var m := mi.mesh
	for s in m.get_surface_count():
		var mat := m.surface_get_material(s)
		if not (mat is StandardMaterial3D): continue
		var nm := String(mat.resource_name)
		if nm.find("Male") < 0 or nm.find("Peasant") >= 0: continue
		var key := "skin:" + nm
		if not _mat_cache.has(key):
			var d: StandardMaterial3D = (mat as StandardMaterial3D).duplicate()
			d.subsurf_scatter_enabled = true
			d.subsurf_scatter_strength = 0.35
			d.subsurf_scatter_skin_mode = true
			d.metallic = 0.0
			d.metallic_specular = 0.35
			d.roughness = minf(1.0, d.roughness * 1.0)
			d.rim_enabled = true
			d.rim = 0.08
			d.rim_tint = 0.8
			_mat_cache[key] = d
		mi.set_surface_override_material(s, _mat_cache[key])
