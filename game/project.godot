; Ronin's Edge - mobile vertical slice
config_version=5

[application]
config/name="Ronin's Edge"
config/description="Cinematic mobile action-RPG set in feudal Japan"
run/main_scene="res://main/Main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]
Game="*res://autoload/Game.gd"
Audio="*res://autoload/Audio.gd"
Quests="*res://autoload/Quests.gd"
Perf="*res://autoload/Perf.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/use_taa=false
environment/defaults/default_clear_color=Color(0.62,0.72,0.86,1)
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
textures/default_filters/anisotropic_filtering_level=2

[physics]
common/physics_ticks_per_second=60
3d/default_gravity=22.0
